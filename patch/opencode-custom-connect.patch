+/**
+ * Custom endpoint connect dialog.
+ *
+ * Replaces the provider catalogue that `/connect` normally opens with a single
+ * OpenAI-compatible form: base URL, API key, model. Everything else in opencode
+ * is left alone — this only writes `providers.custom` into the global config,
+ * exactly as if you had typed it into opencode.jsonc by hand.
+ */
+import { TextareaRenderable } from "@opentui/core"
+import { useRenderer } from "@opentui/solid"
+import { For, Show, createEffect, createSignal, onMount } from "solid-js"
+import { useCursorStyle } from "../config"
+import { Keymap } from "../context/keymap"
+import { useTheme } from "../context/theme"
+import { DialogFooter, DialogHeader, DialogLayout, useDialog } from "../ui/dialog"
+import { Spinner } from "../component/spinner"
+
+/** Provider id the custom endpoint is written under. */
+export const CUSTOM_PROVIDER_ID = "custom"
+
+/** Default display name; opencode shows this wherever a provider name is needed. */
+export const CUSTOM_PROVIDER_NAME = "Custom"
+
+/** Provider package that speaks plain OpenAI /chat/completions. */
+export const COMPATIBLE_PACKAGE = "@opencode/ai/providers/openai-compatible"
+
+type Field = {
+  key: "baseURL" | "apiKey" | "model"
+  label: string
+  placeholder: string
+  mask?: boolean
+  hint?: string
+}
+
+const FIELDS: Field[] = [
+  {
+    key: "baseURL",
+    label: "Base URL",
+    placeholder: "https://host/v1",
+    hint: "OpenAI-compatible root. /chat/completions and /models are appended to it.",
+  },
+  {
+    key: "apiKey",
+    label: "API key",
+    placeholder: "sk-… (leave blank if the endpoint needs none)",
+    mask: true,
+    hint: "Stored in the opencode config file. Use an env var reference if you'd rather not keep it there.",
+  },
+  {
+    key: "model",
+    label: "Model ID",
+    placeholder: "glm-4.7-flash",
+    hint: "Exactly as the endpoint reports it in /models.",
+  },
+]
+
+export type CustomConnectResult = {
+  baseURL: string
+  apiKey?: string
+  model: string
+}
+
+/**
+ * Writes or updates `providers.<id>` in the global opencode config.
+ *
+ * The config file is watched by the server, so an edit here reloads providers
+ * on its own — no restart, and no bespoke IPC for something the file already does.
+ */
+export async function writeCustomProvider(
+  directory: string,
+  id: string,
+  result: CustomConnectResult,
+): Promise<{ path: string }> {
+  const fs = await import("node:fs/promises")
+  const os = await import("node:os")
+  const pathMod = await import("node:path")
+
+  const xdg = process.env.XDG_CONFIG_HOME || pathMod.join(os.homedir(), ".config")
+  const dir = pathMod.join(xdg, "opencode")
+  const file = pathMod.join(dir, "opencode.jsonc")
+
+  let existing: any = {}
+  for (const candidate of ["opencode.jsonc", "opencode.json"]) {
+    try {
+      const text = await fs.readFile(pathMod.join(dir, candidate), "utf8")
+      existing = parseJsonc(text)
+      break
+    } catch {
+      /* try the next name */
+    }
+  }
+
+  const providers = { ...(existing.providers ?? {}) }
+  const previous = providers[id] ?? {}
+  // Native v2 provider shape: `package` + `settings` + `models[id].package`.
+  // (The v1 shape — `npm`/`options` under the plural key — is not migrated, so it is dropped.)
+  providers[id] = {
+    ...previous,
+    name: previous.name ?? CUSTOM_PROVIDER_NAME,
+    package: previous.package ?? COMPATIBLE_PACKAGE,
+    settings: {
+      ...(previous.settings ?? {}),
+      baseURL: result.baseURL,
+      ...(result.apiKey ? { apiKey: result.apiKey } : {}),
+    },
+    models: {
+      ...(previous.models ?? {}),
+      [result.model]: {
+        ...(previous.models?.[result.model] ?? {}),
+        name: result.model,
+        package: COMPATIBLE_PACKAGE,
+      },
+    },
+  }
+
+  const next = {
+    ...existing,
+    providers,
+    // Point the default model at the endpoint we just connected.
+    model: { providerID: id, model: result.model },
+  }
+  await fs.mkdir(dir, { recursive: true })
+  await fs.writeFile(file, JSON.stringify(next, null, 2) + "\n", "utf8")
+  return { path: file }
+}
+
+/**
+ * Minimal JSONC reader: strips comments and trailing commas so a config that a
+ * human has annotated still round-trips. This is deliberately small — the real
+ * parser lives in the server, and this file only needs to preserve it.
+ */
+function parseJsonc(text: string): any {
+  let out = ""
+  let inString = false
+  let inLine = false
+  let inBlock = false
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i]
+    const n = text[i + 1]
+    if (inLine) {
+      if (c === "\n") {
+        inLine = false
+        out += c
+      }
+      continue
+    }
+    if (inBlock) {
+      if (c === "*" && n === "/") {
+        inBlock = false
+        i++
+      }
+      continue
+    }
+    if (inString) {
+      out += c
+      if (c === "\\") {
+        out += text[++i] ?? ""
+        continue
+      }
+      if (c === '"') inString = false
+      continue
+    }
+    if (c === '"') {
+      inString = true
+      out += c
+      continue
+    }
+    if (c === "/" && n === "/") {
+      inLine = true
+      i++
+      continue
+    }
+    if (c === "/" && n === "*") {
+      inBlock = true
+      i++
+      continue
+    }
+    out += c
+  }
+  // trailing commas
+  out = out.replace(/,(\s*[}\]])/g, "$1")
+  try {
+    return JSON.parse(out)
+  } catch {
+    return {}
+  }
+}
+
+export function DialogCustomConnect(props: {
+  onConnected?: (providerID: string) => void
+  directory: string
+}) {
+  const dialog = useDialog()
+  const theme = useTheme().surface("dialog")
+  const renderer = useRenderer()
+  const cursorStyle = useCursorStyle()
+
+  const [step, setStep] = createSignal(0)
+  const [values, setValues] = createSignal<Record<string, string>>({})
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal<string>()
+  const [status, setStatus] = createSignal<string>()
+
+  let textarea: TextareaRenderable | undefined
+  const field = () => FIELDS[step()]
+
+  function focusInput() {
+    setTimeout(() => {
+      if (!textarea || textarea.isDestroyed) return
+      textarea.focus()
+      textarea.gotoLineEnd()
+      textarea.setText(values()[field().key] ?? "")
+    }, 1)
+  }
+
+  function commit(value: string) {
+    setValues((prev) => ({ ...prev, [field().key]: value.trim() }))
+  }
+
+  async function submit() {
+    if (busy()) return
+    const v = { ...values() }
+    if (field().key === "model" && textarea) v.model = textarea.plainText.trim()
+
+    if (!v.baseURL) {
+      setError("A base URL is required.")
+      return
+    }
+    if (!v.model) {
+      setError("A model ID is required.")
+      return
+    }
+
+    setBusy(true)
+    setError(undefined)
+    setStatus("writing config…")
+    try {
+      const result = await writeCustomProvider(props.directory, CUSTOM_PROVIDER_ID, {
+        baseURL: v.baseURL.replace(/\/+$/, ""),
+        apiKey: v.apiKey || undefined,
+        model: v.model,
+      })
+      setStatus(`saved to ${result.path}`)
+      props.onConnected?.(CUSTOM_PROVIDER_ID)
+      dialog.clear()
+    } catch (e) {
+      setError(String(e instanceof Error ? e.message : e))
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  function next() {
+    if (busy()) return
+    if (textarea) commit(textarea.plainText)
+    setError(undefined)
+    if (step() < FIELDS.length - 1) {
+      setStep(step() + 1)
+      focusInput()
+      return
+    }
+    void submit()
+  }
+
+  function back() {
+    if (busy()) return
+    if (textarea) commit(textarea.plainText)
+    setError(undefined)
+    if (step() > 0) {
+      setStep(step() - 1)
+      focusInput()
+    } else {
+      dialog.clear()
+    }
+  }
+
+  Keymap.createLayer(() => ({
+    mode: "modal",
+    enabled: !busy(),
+    priority: 1,
+    commands: [
+      { bind: "return", title: "Next field", group: "Dialog", run: next },
+      { bind: "tab", title: "Next field", group: "Dialog", run: next },
+    ],
+  }))
+
+  Keymap.createLayer(() => ({
+    mode: "modal",
+    enabled: !busy(),
+    priority: 1,
+    commands: [
+      {
+        bind: "escape",
+        title: "Back",
+        group: "Dialog",
+        run: () => {
+          if (renderer.getSelection()) {
+            renderer.clearSelection()
+            return
+          }
+          back()
+        },
+      },
+    ],
+  }))
+
+  createEffect(() => {
+    if (!textarea || textarea.isDestroyed) return
+    textarea.traits = busy() ? { suspend: true, status: "BUSY" } : {}
+    if (busy()) {
+      textarea.blur()
+      return
+    }
+    textarea.focus()
+  })
+
+  onMount(() => {
+    dialog.setSize("medium")
+    focusInput()
+  })
+
+  return (
+    <DialogLayout
+      footerGap={2}
+      header={
+        <DialogHeader
+          title="Connect a custom endpoint"
+          description="Any OpenAI-compatible API. Nothing else to choose."
+          onClose={() => {
+            if (!busy()) dialog.clear()
+          }}
+        />
+      }
+      footer={{
+        actions: {
+          primary: [
+            { title: step() === FIELDS.length - 1 ? "connect" : "next", command: "dialog.custom.next", disabled: busy(), onTrigger: next },
+          ],
+        },
+      }}
+      legacyFooter={
+        <Show when={!busy()} fallback={<text fg={theme.text.muted}>saving…</text>}>
+          <DialogFooter
+            actions={{
+              secondary: [
+                { title: step() === FIELDS.length - 1 ? "connect" : "next", command: "dialog.custom.next", onTrigger: next },
+                { title: step() > 0 ? "back" : "cancel", command: "dialog.custom.back", onTrigger: back },
+              ],
+            }}
+          />
+        </Show>
+      }
+    >
+      <box gap={1}>
+        <box flexDirection="row" gap={1}>
+          <For each={FIELDS}>
+            {(f, i) => (
+              <text fg={i() === step() ? theme.text.action.primary.focused : theme.text.muted}>
+                {i() < step() ? "✓ " : ""}
+                {f.label}
+                {i() < FIELDS.length - 1 ? "  →" : ""}
+              </text>
+            )}
+          </For>
+        </box>
+
+        <text fg={theme.text.muted}>{field().hint}</text>
+
+        <textarea
+          height={1}
+          wrapMode="none"
+          ref={(val: TextareaRenderable) => {
+            textarea = val
+          }}
+          placeholder={field().placeholder}
+          placeholderColor={theme.text.muted}
+          textColor={busy() ? theme.text.formfield.disabled : theme.text.formfield.base}
+          focusedTextColor={busy() ? theme.text.formfield.disabled : theme.text.formfield.base}
+          cursorColor={busy() ? theme.background.formfield.disabled : theme.text.base}
+          cursorStyle={cursorStyle()}
+        />
+
+        <Show when={field().mask && values().apiKey}>
+          <text fg={theme.text.muted}>
+            {values().apiKey ? "key: " + "•".repeat(Math.min(values().apiKey!.length, 40)) : ""}
+          </text>
+        </Show>
+
+        <Show when={error()}>
+          <text fg={theme.text.feedback.error.base}>{error()}</text>
+        </Show>
+
+        <Show when={busy() || status()}>
+          <Show when={busy()} fallback={<text fg={theme.text.feedback.success.base}>{status()}</text>}>
+            <Spinner color={theme.text.muted}>{status() ?? "saving…"}</Spinner>
+          </Show>
+        </Show>
+      </box>
+    </DialogLayout>
+  )
+}
